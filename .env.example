# Postgres connection string.
# Local dev:  postgres://localhost:5432/unkad_platform
# Production: your Neon connection string (postgres://...neon.tech/...?sslmode=require)
DATABASE_URL=postgres://localhost:5432/unkad_platform

# Signs the unsubscribe links in event mail (/kulan). Required in production
# for confirmation emails and reminders to be sent; without it registration
# still works but no event mail goes out. `next dev` uses a fixed dev secret.
# Generate with: openssl rand -hex 32
# Must be the same value wherever scripts/event-reminders.mjs runs.
EVENT_TOKEN_SECRET=
