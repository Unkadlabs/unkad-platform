<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS launchd job: nightly Unkad database backup at 02:00 local time.

     Install:
       cp scripts/com.unkad.backup.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.unkad.backup.plist

     Check:   launchctl list | grep unkad
     Logs:    ~/UnkadBackups/backup.log
     Remove:  launchctl unload ~/Library/LaunchAgents/com.unkad.backup.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.unkad.backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/khalidyusufdahir/research/unkad/unkad-platform/scripts/backup.sh</string>
  </array>

  <!-- Was 02:00, which failed every night from 26 July. The DNS retry loop
       could not save it: a sleeping Mac has no network, and each `sleep 30`
       spanned an hour of wall clock because the machine was suspended through
       it. Five retries covered five hours of sleep and resolved nothing, so
       the dump aborted and the log filled with what looked like a DNS fault.

       So run when the machine is actually awake and online. Twice, because one
       missed window should not cost a day: if the morning run succeeds the
       evening one simply writes a second dump, and pruning handles the rest. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key><integer>13</integer>
      <key>Minute</key><integer>37</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>21</integer>
      <key>Minute</key><integer>37</integer>
    </dict>
  </array>

  <!-- If the Mac was asleep at the scheduled time, run once it wakes. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/khalidyusufdahir/UnkadBackups/backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/khalidyusufdahir/UnkadBackups/backup.log</string>
</dict>
</plist>
